# Ignore Visual Studio Code settings and build output
.vscode/

# Ignore build output
/bin/
/otprobe

# Ignore coverage files
cover.*
coverage.*
*.out/cmd/otprobe/otprobe

# Build artefacts live in /bin/ and /release/ (otfabric/engineering REPO-005)
/release/
*.test
coverage.out

# Output of a bare `go build`, anchored so it can never hide a source folder
/cmd/otprobe/otprobe
/examples/custom/custom
/examples/identify/identify
/examples/observe/observe
/examples/quickstart/quickstart
/examples/sweep/sweep
/internal/cmd/gencip/gencip
